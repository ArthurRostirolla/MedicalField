{
  "name": "@medicalfield/lucky-patcher",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "description": "LuckyPatcher - app Offline-First do profissional de saude (Expo: Android + web)",
  "scripts": {
    "dev": "npm run worker && expo start",
    "web": "npm run worker && expo start --web --port 5182",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "worker": "node scripts/worker.mjs",
    "build": "node scripts/build-web.mjs dist",
    "build:diagnostico": "node scripts/build-web.mjs dist-diagnostico --diagnostico",
    "preview:diagnostico": "node scripts/servir.mjs dist-diagnostico 5183",
    "preview:producao": "node scripts/servir.mjs dist 5184",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@medicalfield/contratos": "*",
    "@medicalfield/dominio": "*",
    "@sqlite.org/sqlite-wasm": "^3.54.1-build1",
    "expo": "~58.0.26",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-font": "~58.0.12",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "lucide-react-native": "^1.75.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "esbuild": "^0.28.2",
    "jsdom": "^26.0.0",
    "sql.js": "^1.16.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "workbox-build": "^7.4.1"
  }
}
