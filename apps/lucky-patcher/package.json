{
  "name": "@medicalfield/lucky-patcher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LuckyPatcher - app Offline-First do profissional de saude (PWA + Android via Capacitor)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:diagnostico": "vite build --mode diagnostico --outDir dist-diagnostico",
    "preview": "vite preview",
    "preview:diagnostico": "vite preview --outDir dist-diagnostico",
    "preview:producao": "vite preview --port 5184 --strictPort",
    "build:android": "vite build --mode android && cap sync android",
    "build:android:producao": "vite build --mode android-producao && cap sync android",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.6.2",
    "@medicalfield/contratos": "*",
    "@medicalfield/dominio": "*",
    "@medicalfield/ui": "*",
    "@sqlite.org/sqlite-wasm": "^3.54.1-build1",
    "lucide-react": "^0.500.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jeep-sqlite": "^2.8.0",
    "jsdom": "^26.0.0",
    "sql.js": "^1.16.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
