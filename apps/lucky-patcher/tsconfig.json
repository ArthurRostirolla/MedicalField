{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node",
      "react-native"
    ],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "customConditions": [
      "react-native"
    ]
  },
  "include": [
    "app",
    "src",
    "e2e",
    "scripts",
    "app.config.ts"
  ]
}
