# Modelo de deploy/.env (fora do Git). deploy/scripts/segredos.sh copia este arquivo e gera o que
# estiver vazio em SENHA_* e JWT_CHAVE_PRIVADA_PEM. Guarde uma copia do .env fora da maquina:
# as senhas do banco so sao aplicadas na PRIMEIRA partida do Postgres.
COMPOSE_PROJECT_NAME=medicalfield

# --- VM (descomente) -----------------------------------------------------------------------
# COMPOSE_FILE=compose.yaml:compose.vm.yaml
# MF_REGISTRO=ghcr.io/arthurrostirolla/medicalfield
# MF_TAG=latest
# MF_PORTA_HTTP=80
# MF_HOST=177-44-248-60.sslip.io
# MF_ACME_EMAIL=
# URL_PUBLICA_PORTAL=https://177-44-248-60.sslip.io/portal

# "on" cria os profissionais ficticios com senha publicada. NUNCA com dados reais.
DADOS_DEMO=on

# SMTP externo (opcional). Vazio = Mailpit. Com usuario/senha, SMTP_SEGURANCA starttls ou tls.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORTA=587
# SMTP_SEGURANCA=starttls
# EMAIL_REMETENTE=MedicalField <conta@gmail.com>
SMTP_USUARIO=
SMTP_SENHA=

# Segredos (gerados por segredos.sh). Senhas: so letras, numeros, "_" e "-" (entram numa URL).
SENHA_POSTGRES_ADMIN=
SENHA_MF_MIKE=
SENHA_MF_CIDA=
SENHA_MF_JAIMINHO=
# Ed25519 PKCS#8 em PEM, numa linha com \n literais, entre aspas simples
JWT_CHAVE_PRIVADA_PEM=
