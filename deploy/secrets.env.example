# Modelo do arquivo de segredos lido por deploy/scripts/criar-secrets.sh.
#   cp deploy/secrets.env.example deploy/secrets.env     (deploy/**/secrets*.env esta no .gitignore)
#   deploy/scripts/criar-secrets.sh deploy/secrets.env
#
# O que ficar vazio e GERADO pelo script e gravado de volta neste arquivo. Guarde o arquivo:
# as senhas do banco so sao aplicadas na PRIMEIRA partida do Postgres; perder o arquivo e
# perder a senha (veja docs/operacao/troubleshooting.md para trocar uma senha depois).
# Senhas do banco: apenas letras, numeros, "_" e "-" (entram numa URL).

SENHA_POSTGRES_ADMIN=
SENHA_MF_MIKE=
SENHA_MF_CIDA=
SENHA_MF_JAIMINHO=

# Chave privada Ed25519 do JWT, PEM PKCS#8 em base64 de uma linha so. Vazia = o script gera.
JWT_CHAVE_PRIVADA_PEM_B64=

# SMTP externo (opcional). Vazio = sem autenticacao (Mailpit do cluster).
# Host, porta e seguranca nao sao segredo: ficam em deploy/overlays/univates/kustomization.yaml.
SMTP_USUARIO=
SMTP_SENHA=
